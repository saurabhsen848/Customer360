table customer_churn_cleaned
	lineageTag: 5ddfbe52-bf64-4654-a3a8-8bc9a883858a

	measure 'Total Customers' =
			
			DISTINCTCOUNT(customer_churn_cleaned[customerID])
		formatString: 0
		lineageTag: d6c56bb9-0b29-4627-8ae4-cb5a0d0b9522

	measure 'Churned Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT(customer_churn_cleaned[customerID]),
			    customer_churn_cleaned[Churn] = "Yes"
			)
		formatString: 0
		lineageTag: 0b751071-26ad-4962-9989-1ddc15fe9665

	measure 'Churn Rate' =
			
			DIVIDE(
			    [Churned Customers],
			    [Total Customers],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c94cde78-e120-4a7a-931b-dc8f80bd2b32

	measure 'Retained Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT(customer_churn_cleaned[customerID]),
			    customer_churn_cleaned[Churn] = "No"
			)
		formatString: 0
		lineageTag: dfc4ca59-34dd-4ad7-bfd0-b690aa56ef71

	measure 'Average Monthly Charges' =
			
			AVERAGE(customer_churn_cleaned[MonthlyCharges])
		lineageTag: 3aaf04d3-0374-4bb0-9114-3ea482c1a2f2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Tenure' =
			
			AVERAGE(customer_churn_cleaned[tenure])
		lineageTag: 959a2b54-c088-4ba2-a0d5-2b6b9d498ac8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Total Charges' =
			
			AVERAGE(customer_churn_cleaned[TotalCharges])
		lineageTag: 3aea5f59-977c-468d-9927-c7a248134511

		annotation PBI_FormatHint = {"isGeneralNumber":true}

