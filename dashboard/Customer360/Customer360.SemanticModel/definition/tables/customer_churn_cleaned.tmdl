	column 'Tenure Group' =
			
			SWITCH(
			    TRUE(),
			    customer_churn_cleaned[tenure] <= 12, "0-12 months",
			    customer_churn_cleaned[tenure] <= 24, "13-24 months",
			    customer_churn_cleaned[tenure] <= 48, "25-48 months",
			    "49+ months"
			)
		lineageTag: 055f3eda-07fd-4fef-9576-3e914e617241
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Customer Segment' =
			
			SWITCH(
			    TRUE(),
			    customer_churn_cleaned[MonthlyCharges] < 35, "Low Value",
			    customer_churn_cleaned[MonthlyCharges] < 70, "Medium Value",
			    "High Value"
			)
		lineageTag: 57ec2308-df3d-440b-834b-50c17b940032
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

